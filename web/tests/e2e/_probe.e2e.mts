import { startApp } from "./harness.mts";
const app = await startApp({ port: 3291, suite: "_probe" });
const pa = await app.api("u_pa_priya", "GET", "/api/pa-today");
console.log(JSON.stringify(pa.data.tasks.map((t:any)=>[t.kind,t.label,t.patient,t.actions.map((a:any)=>a.label+":"+(a.api?JSON.stringify(a.api):a.href))]),null,0));
console.log(JSON.stringify(pa.data.doneToday), JSON.stringify(pa.data.counts));
const d = await app.api("u_dr_rao", "GET", "/api/dashboard");
for (const p of d.data.patients) console.log(p.id, p.status, JSON.stringify(p.triage).slice(0,300), p.open.length);
console.log("activity", JSON.stringify(d.data.activity).slice(0,800));
const d2 = await app.api("u_dr_dileep", "GET", "/api/dashboard");
console.log(d2.data.patients.map((p:any)=>p.id));
console.log(JSON.stringify(app.q("SELECT id, role FROM users")));
console.log(JSON.stringify(app.q("SELECT id, patient_id, title, mime, filed_at FROM patient_documents")));
console.log(JSON.stringify(app.q("SELECT id, patient_id, med_name, status, outside_visit_id FROM med_changes WHERE status='REPORTED'")));
console.log(app.q("SELECT id, patient_id, type, state, level FROM escalations WHERE state IN ('NOTIFIED','ACKNOWLEDGED')"));
console.log(app.q("SELECT * FROM consents WHERE status != 'GIVEN'"));
await app.stop();
