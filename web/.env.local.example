# CareCircle — Environment Configuration
# Add your Google Gemini API Key below.
# Get a key at: https://aistudio.google.com/app/apikey

GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Optional Model Override (Defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# Optional custom database path
# CARECIRCLE_DB="/custom/path/to/carecircle.db"

# Real WhatsApp via Twilio (live-clinic mode only; see docs/WHATSAPP_GO_LIVE.md). Leave unset to use only the simulator.
# Put real values in .env.local (not committed), never in this file.
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_WHATSAPP_FROM="+919035913536"
# PUBLIC_BASE_URL="https://your-tunnel-or-domain"
# TWILIO_TEMPLATE_UPDATE="HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_TEMPLATE_ALERT="HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# WHATSAPP_ALLOWLIST="+9198xxxxxxxx"   # only these numbers get real messages while testing
# WHATSAPP_GATEWAY="off"               # kill switch: stop all real sending
