{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "clinic",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "clinic"
      ],
      "port": 3100
    },
    {
      "name": "demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "demo-story",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CARECIRCLE_DB=data/demo-story.db",
        "npm",
        "--prefix",
        "web",
        "run",
        "clinic"
      ],
      "port": 3100
    },
    {
      "name": "demo-ready",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CARECIRCLE_DB=data/demo-ready.db",
        "npm",
        "--prefix",
        "web",
        "run",
        "clinic"
      ],
      "port": 3100
    }
  ]
}